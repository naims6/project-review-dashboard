// use prisma-8

enum Role {
  STUDENT
  MENTOR
  ADMIN
}

enum ProjectStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id               String     @id @default(uuid())
  name             String
  email            String     @unique
  password         String
  role             Role       @default(STUDENT)
  submittedProjects Project[] @relation("StudentProjects")
  reviewedProjects  Project[] @relation("ReviewedProjects")
  createdAt        DateTime   @default(now())
  updatedAt        temporal.updatedAt()

  @@index([role])
}

model Project {
  id            String        @id @default(uuid())
  name          String
  repoUrl       String        @unique
  liveUrl       String
  description   String
  status        ProjectStatus @default(PENDING)

  studentId     String
  student       User          @relation("StudentProjects", fields: [studentId], references: [id], onDelete: Restrict)

  reviewedById  String?
  reviewedBy    User?         @relation("ReviewedProjects", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  reviewComment String?

  createdAt     DateTime      @default(now())
  updatedAt     temporal.updatedAt()

  @@index([status, createdAt])
  @@index([studentId, createdAt])
}

